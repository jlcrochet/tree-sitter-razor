#!/bin/bash
# Git post-checkout hook for tree-sitter-razor
# Verifies C# token count compatibility after checkout/submodule update.
#
# Install with: ln -sf ../../scripts/git-hooks/post-checkout .git/hooks/post-checkout

# post-checkout receives: previous HEAD, new HEAD, branch flag (1 if branch checkout)
PREV_HEAD="$1"
NEW_HEAD="$2"
BRANCH_FLAG="$3"

# Check if tree-sitter-c-sharp submodule was modified
if git diff --name-only "$PREV_HEAD" "$NEW_HEAD" 2>/dev/null | grep -q '^tree-sitter-c-sharp'; then
    echo "tree-sitter-c-sharp submodule changed, checking token compatibility..."
    if [ -x ./scripts/check-csharp-tokens.sh ]; then
        ./scripts/check-csharp-tokens.sh || {
            echo ""
            echo "WARNING: C# token count mismatch detected!"
            echo "Please update CSHARP_TOKEN_COUNT in src/scanner.c before building."
        }
    fi
fi
